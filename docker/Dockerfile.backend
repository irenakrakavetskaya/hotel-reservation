# syntax=docker/dockerfile:1
#
# Backend image — Symfony on PHP-FPM.
# Runs behind the `nginx` reverse-proxy service (see docker/nginx/default.conf,
# docker-compose.yml), which speaks FastCGI to this container on port 9000.
#
# Symfony 8 requires PHP 8.4.

ARG PHP_VERSION=8.4

# ---------- Stage 1: composer dependencies ----------
FROM composer:2 AS composer_deps
WORKDIR /app
COPY composer.* ./
# --no-scripts / --no-autoloader: app code isn't copied in yet, so
# post-install scripts and the classmap have nothing to run against.
RUN composer install \       
        --no-scripts \
        --no-autoloader \
        --no-interaction \
        --prefer-dist

# ---------- Stage 2: runtime ----------
FROM php:${PHP_VERSION}-fpm-alpine AS runtime

RUN apk add --no-cache \
        icu-dev \
        libzip-dev \
        postgresql-dev \
        $PHPIZE_DEPS \
    && docker-php-ext-configure intl \
    && docker-php-ext-install -j"$(nproc)" \
        intl \
        pdo_pgsql \
        zip \
        opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS

COPY --from=composer_deps /usr/bin/composer /usr/bin/composer

# Production opcache/php.ini settings.
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'opcache.memory_consumption=256'; \
        echo 'realpath_cache_size=4096K'; \
        echo 'realpath_cache_ttl=600'; \
    } > /usr/local/etc/php/conf.d/symfony-prod.ini

WORKDIR /app

COPY --from=composer_deps --chown=www-data:www-data /app/vendor ./vendor
COPY . .

RUN printf 'APP_ENV=dev\nAPP_DEBUG=0\n' > .env

# Generate the autoloader now that app code is present; composer install in
# stage 1 skipped this because vendor/ was populated before src/ existed.
RUN composer dump-autoload --optimize --classmap-authoritative

# Symfony cache/log dirs must be writable by the FPM process;
# www-data is the default php-fpm-alpine user/group.
RUN mkdir -p var/cache var/log \
    && chown -R www-data:www-data var

USER www-data

ENV APP_ENV=dev
EXPOSE 9000

CMD ["php-fpm"]
